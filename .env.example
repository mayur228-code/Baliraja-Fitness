# ==============================================================================
# Baliraja Fitness - Environment Configuration
# ==============================================================================

# 1. APK Download URL Configuration
# When deploying to production / GitHub Releases, specify the direct download link
# for the release APK (e.g. GitHub Releases asset URL or CDN URL).
# If left empty, the application defaults to serving the local '/app-release.apk'.
VITE_APK_DOWNLOAD_URL=https://github.com/YOUR_USERNAME/Baliraja_Fitness/releases/download/v1.0.0/app-release.apk

# 2. Base Public Web Application URL
# Used for canonical QR code generation when sharing reports or download links.
# If omitted, the app dynamically uses window.location.origin.
# VITE_APP_URL=https://your-domain.com

# 3. Optional Release Information Overrides
# VITE_APP_VERSION=1.0.0
# VITE_APK_FILE_NAME=app-release.apk
# VITE_APK_FILE_SIZE=29.8 MB
